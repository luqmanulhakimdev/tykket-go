{
  "info": {
    "name": "Tykket API Collection",
    "description": "Comprehensive Postman & Insomnia collection for Tykket (Work Management & Issue Tracking System)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "sprint_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "issue_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "issue_key",
      "value": "TYK-1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Mercer\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.tokens) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.tokens.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@tykket.dev\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"your_refresh_token_here\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Projects & Workspace",
      "item": [
        {
          "name": "List User Projects",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects"]
            }
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile App Redesign\",\n  \"key\": \"MOB\",\n  \"description\": \"Next-gen mobile experience for iOS and Android\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects"]
            }
          }
        },
        {
          "name": "Get Project by ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}"]
            }
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile App Redesign v2\",\n  \"description\": \"Updated project scope\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}"]
            }
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Project Members & RBAC",
      "item": [
        {
          "name": "List Project Members",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/members",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "members"]
            }
          }
        },
        {
          "name": "Add Member to Project",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member@tykket.dev\",\n  \"role_name\": \"MEMBER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/members",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "members"]
            }
          }
        },
        {
          "name": "Update Member Role",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role_name\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/members/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "members", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Remove Member from Project",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/members/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "members", "{{user_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Sprints & Backlog",
      "item": [
        {
          "name": "List Sprints",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/sprints",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "sprints"]
            }
          }
        },
        {
          "name": "Create Sprint",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sprint 1 - Foundation\",\n  \"goal\": \"Deliver core onboarding experience\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/sprints",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "sprints"]
            }
          }
        },
        {
          "name": "Start Sprint",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/sprints/{{sprint_id}}/start",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "sprints", "{{sprint_id}}", "start"]
            }
          }
        },
        {
          "name": "Complete Sprint",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"move_incomplete_to_sprint_id\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/sprints/{{sprint_id}}/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "sprints", "{{sprint_id}}", "complete"]
            }
          }
        },
        {
          "name": "Bulk Move Issues",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"issue_ids\": [\"{{issue_id}}\"],\n  \"sprint_id\": \"{{sprint_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/sprints/bulk-move",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "sprints", "bulk-move"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Core Issues & Kanban Board",
      "item": [
        {
          "name": "List Issues (with filters & pagination)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/issues?page=1&limit=50&status=TODO",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "issues"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "50"},
                {"key": "status", "value": "TODO"},
                {"key": "in_backlog", "value": "true", "disabled": true},
                {"key": "sprint_id", "value": "{{sprint_id}}", "disabled": true},
                {"key": "type", "value": "TASK", "disabled": true},
                {"key": "search", "value": "auth", "disabled": true}
              ]
            }
          }
        },
        {
          "name": "Create Issue",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"TASK\",\n  \"priority\": \"HIGH\",\n  \"title\": \"Implement Google OAuth SSO\",\n  \"description\": \"Integrate Google Identity Services with Tykket backend\",\n  \"story_points\": 5,\n  \"position\": 1000.0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/issues",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "issues"]
            }
          }
        },
        {
          "name": "Get Issue Details (by ID)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/issues/{{issue_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "issues", "{{issue_id}}"]
            }
          }
        },
        {
          "name": "Get Issue by Key (Global Lookup)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/issues/{{issue_key}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "issues", "{{issue_key}}"]
            }
          }
        },
        {
          "name": "Move Issue (Kanban Drag-and-Drop)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"position\": 1500.0,\n  \"sprint_id\": \"{{sprint_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/issues/{{issue_id}}/move",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "issues", "{{issue_id}}", "move"]
            }
          }
        },
        {
          "name": "Update Issue Details",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement Google OAuth SSO & Apple Sign-In\",\n  \"priority\": \"URGENT\",\n  \"story_points\": 8\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/issues/{{issue_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "issues", "{{issue_id}}"]
            }
          }
        },
        {
          "name": "Delete Issue",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/issues/{{issue_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "issues", "{{issue_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Metrics & Data Export",
      "item": [
        {
          "name": "Get Project Summary Metrics",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/metrics",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "metrics"]
            }
          }
        },
        {
          "name": "Get Sprint Burndown Chart Data",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/sprints/{{sprint_id}}/burndown",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "sprints", "{{sprint_id}}", "burndown"]
            }
          }
        },
        {
          "name": "Export Issues as CSV",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/export/csv",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "export", "csv"],
              "query": [
                {"key": "status", "value": "TODO", "disabled": true},
                {"key": "in_backlog", "value": "true", "disabled": true}
              ]
            }
          }
        },
        {
          "name": "Export Project Summary (JSON)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/export/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "projects", "{{project_id}}", "export", "summary"]
            }
          }
        }
      ]
    }
  ]
}

